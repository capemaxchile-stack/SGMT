# ============================================
# SGMT - Sistema de Gestión Movimiento de Tierra
# Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# --- Database ---
POSTGRES_USER=sgmt
POSTGRES_PASSWORD=sgmt_dev_2026
POSTGRES_DB=sgmt
DATABASE_URL=postgresql://sgmt:sgmt_dev_2026@db:5432/sgmt?schema=public

# --- API ---
API_PORT=3000
NODE_ENV=development

# --- Auth / JWT ---
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too-different-from-access-secret
JWT_REFRESH_EXPIRES_IN=7d

# --- Super User ---
# The super user authorization key is per-user, stored hashed in DB.
# This is the default seed password for the initial super user.
SUPER_USER_SEED_PASSWORD=super_seed_2026

# --- Frontend ---
VITE_API_URL=http://localhost:3000/api
