generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  name             String
  passwordHash     String
  superKeyHash     String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  roles            UserRole[]
  authorizations   Authorization[]
  faenasAsChief    Faena[]           @relation("FaenaChief")
  movementsCreated WarehouseMovement[]
  requestsCreated  PurchaseRequest[]
  auditLogs        AuditLog[]
}

model Role {
  id                 String             @id @default(uuid())
  name               String             @unique
  displayName        String
  maxApprovalAmount  Decimal?
  level              Int
  users              UserRole[]
  // attributionRules Relation not specified in user prompt fully, left stubbed if needed
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

enum FaenaStatus {
  EN_FORMACION
  ACTIVA
  EN_CIERRE
  CERRADA
}

model Faena {
  id                 String              @id @default(uuid())
  name               String
  location           String
  status             FaenaStatus
  startDate          DateTime
  endDate            DateTime?
  chiefId            String?
  chief              User?               @relation("FaenaChief", fields: [chiefId], references: [id])
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  contracts          Contract[]
  assets             AssetAssignment[]
  warehouseMovements WarehouseMovement[]
  purchaseRequests   PurchaseRequest[]
}

model Contract {
  id          String       @id @default(uuid())
  number      String
  clientName  String
  amount      Decimal
  startDate   DateTime
  endDate     DateTime?
  faenaId     String
  faena       Faena        @relation(fields: [faenaId], references: [id])
  costCenters CostCenter[]
}

model CostCenter {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id])
}

enum AssetType {
  EXCAVADORA
  RETROEXCAVADORA
  BULLDOZER
  CAMION_TOLVA
  CAMION_PLUMA
  CAMIONETA
  RODILLO
  MOTONIVELADORA
  CARGADOR_FRONTAL
  OTRO
}

enum AssetOperationalStatus {
  OPERATIVO
  EN_MANTENCION
  DETENIDO
  DADO_DE_BAJA
}

model Asset {
  id                 String                 @id @default(uuid())
  type               AssetType
  brand              String
  model              String
  year               Int
  licensePlate       String?
  internalNumber     String                 @unique
  operationalStatus  AssetOperationalStatus
  currentHourmeter   Decimal                @default(0)
  currentKilometrage Decimal                @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  assignments        AssetAssignment[]
  warehouseMovements WarehouseMovement[]
}

model AssetAssignment {
  id        String    @id @default(uuid())
  assetId   String
  faenaId   String
  startDate DateTime
  endDate   DateTime?
  createdAt DateTime  @default(now())
  asset     Asset     @relation(fields: [assetId], references: [id])
  faena     Faena     @relation(fields: [faenaId], references: [id])
}

enum WarehouseType {
  CENTRAL
  FAENA
}

model Warehouse {
  id        String              @id @default(uuid())
  name      String
  location  String
  type      WarehouseType
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  stocks    Stock[]
  movements WarehouseMovement[]
}

model Item {
  id                 String                  @id @default(uuid())
  code               String                  @unique
  description        String
  unitOfMeasure      String
  category           String
  minimumStock       Int                     @default(0)
  isActive           Boolean                 @default(true)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  stocks             Stock[]
  movementLines      WarehouseMovementLine[]
  purchaseOrderLines PurchaseOrderLine[]
}

model Stock {
  id          String    @id @default(uuid())
  itemId      String
  warehouseId String
  quantity    Decimal   @default(0)
  averageCost Decimal   @default(0)
  updatedAt   DateTime  @updatedAt
  item        Item      @relation(fields: [itemId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([itemId, warehouseId])
}

enum MovementType {
  INGRESO
  SALIDA
  AJUSTE
}

model WarehouseMovement {
  id              String                  @id @default(uuid())
  type            MovementType
  movementNumber  String                  @unique
  warehouseId     String
  faenaId         String?
  assetId         String?
  purchaseOrderId String?
  userId          String
  notes           String?
  createdAt       DateTime                @default(now())
  warehouse       Warehouse               @relation(fields: [warehouseId], references: [id])
  faena           Faena?                  @relation(fields: [faenaId], references: [id])
  asset           Asset?                  @relation(fields: [assetId], references: [id])
  purchaseOrder   PurchaseOrder?          @relation(fields: [purchaseOrderId], references: [id])
  user            User                    @relation(fields: [userId], references: [id])
  lines           WarehouseMovementLine[]
}

model WarehouseMovementLine {
  id         String            @id @default(uuid())
  movementId String
  itemId     String
  quantity   Decimal
  unitCost   Decimal           @default(0)
  movement   WarehouseMovement @relation(fields: [movementId], references: [id])
  item       Item              @relation(fields: [itemId], references: [id])
}

model Supplier {
  id             String          @id @default(uuid())
  businessName   String
  rut            String          @unique
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  address        String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]
}

enum RequestStatus {
  BORRADOR
  PENDIENTE
  APROBADA
  RECHAZADA
  CONVERTIDA
}

model PurchaseRequest {
  id            String          @id @default(uuid())
  requestNumber String          @unique
  faenaId       String
  requesterId   String
  status        RequestStatus
  justification String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  faena         Faena           @relation(fields: [faenaId], references: [id])
  requester     User            @relation(fields: [requesterId], references: [id])
  purchaseOrder PurchaseOrder[]
}

enum OrderStatus {
  BORRADOR
  PENDIENTE_APROBACION
  APROBADA
  APROBADA_EXCEPCION
  RECHAZADA
  EMITIDA
  RECEPCION_PARCIAL
  RECEPCION_TOTAL
  CANCELADA
}

model PurchaseOrder {
  id                    String              @id @default(uuid())
  orderNumber           String              @unique
  purchaseRequestId     String?
  supplierId            String
  totalAmount           Decimal
  status                OrderStatus
  deliveryTerms         String?
  estimatedDeliveryDate DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  purchaseRequest       PurchaseRequest?    @relation(fields: [purchaseRequestId], references: [id])
  supplier              Supplier            @relation(fields: [supplierId], references: [id])
  lines                 PurchaseOrderLine[]
  warehouseMovements    WarehouseMovement[]
}

model PurchaseOrderLine {
  id              String        @id @default(uuid())
  purchaseOrderId String
  itemId          String
  quantity        Decimal
  unitPrice       Decimal
  totalPrice      Decimal
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item            Item          @relation(fields: [itemId], references: [id])
}

enum AuthorizationEntityType {
  PURCHASE_ORDER
  WAREHOUSE_MOVEMENT
}

enum AuthorizationAction {
  APROBADA
  RECHAZADA
  EXCEPCION
}

model Authorization {
  id              String                  @id @default(uuid())
  entityType      AuthorizationEntityType
  entityId        String
  userId          String
  action          AuthorizationAction
  level           Int
  comments        String?
  exceptionReason String?
  createdAt       DateTime                @default(now())
  user            User                    @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  timestamp DateTime @default(now())
  userId    String?
  action    String
  entity    String
  entityId  String?
  detail    Json?
  ipAddress String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: NoAction)
}
